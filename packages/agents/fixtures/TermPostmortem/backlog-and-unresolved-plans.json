  "assertions": [
    { "path": "nextTermReadiness", "op": "equals", "value": "Blocked" },
    { "path": "sectionsNeedingReview[0].sectionId", "op": "equals", "value": "section_algebra_a" },
    { "path": "dataQualityIssues", "op": "arrayIncludes", "value": "4 submission(s) are ungraded at term end." },
    { "path": "recommendationsForNextTerm[0]", "op": "contains", "value": "ungraded" },
    { "path": "interventionEffectiveness.narrative", "op": "contains", "value": "still active" }
  ]
}
