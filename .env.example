# Host port for the Postgres container in docker-compose.yml.
# Change this if something else already listens on 5432, then update the port
# in DATABASE_URL below to match.
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentic_education_ops?schema=public"
NEXT_PUBLIC_APP_NAME="Agentic Education Ops"
