# Local environment files. The .example twins are committed; these are not.
# `.env.test` is matched by the `.env*` glob below, but is listed explicitly
# because it was introduced separately (US-04) and is the one most likely to be
# created by hand while following the integration-test setup steps.
.env
.env.local
.env.test
apps/web/.env.local
# Catch-all for any future variant, while keeping the .example files tracked.
.env*.local
!.env.example
!.env.test.example
*.log
*.tsbuildinfo
packages/db/prisma/seed.js
packages/db/prisma/seed.d.ts
packages/db/prisma/seed.d.ts.map
packages/db/prisma/migrations
